{
  "name": "@swath/web",
  "version": "0.0.0",
  "private": true,
  "description": "Swath frontend: vanilla Web Components + MapLibre GL (ADR 0005), no framework. <swath-map> is the viewer; demo/ drives it against the compose stack.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "vite build",
    "lint": "biome ci . && node scripts/check-ui-dry.mjs --warn",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:ui-dry": "node scripts/check-ui-dry.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@vitest/browser-playwright": "4.1.10",
    "playwright": "1.62.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "maplibre-gl": "6.2.0"
  }
}
