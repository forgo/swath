# ---- Rust ----
target/
*.profraw
# Cargo.lock IS committed at the workspace root (binary project); prototype
# subdirs may ignore their own via local .gitignore.
# insta pending snapshots (accepted .snap files ARE committed)
*.snap.new
# profiling artifacts
flamegraph.svg
perf.data*

# ---- Python (uv; uv.lock IS committed) ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.python-version.local
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.hypothesis/

# ---- Node / web (pnpm; pnpm-lock.yaml IS committed) ----
node_modules/
.vite/
# test artifacts
coverage/
lcov.info
playwright-report/
test-results/
.vitest/

# ---- Secrets & local env (never commit) ----
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# ---- Data & artifacts (never commit imagery/cubes; tiny test fixtures live
#      under tests/fixtures/ and are force-added deliberately) ----
*.tif
*.tiff
*.nc
*.hdf
*.h5
*.zarr/
*.parquet
*.grib2
data/
tmp/
scratch/

# ---- Tooling / agents (shared settings ARE committed; local state is not) ----
.claude/*
!.claude/settings.json
.direnv/

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
