---
source: crates/swath-api/tests/openeo_services.rs
expression: shapes
---
{
  "wrong service type": {
    "status": 400,
    "error": {
      "code": "ServiceUnsupported",
      "message": "Service type 'wms' is not supported. Supported: \"xyz\"."
    }
  },
  "missing process graph": {
    "status": 400,
    "error": {
      "code": "ProcessGraphMissing",
      "message": "Invalid process specified. It doesn't contain a process graph."
    }
  },
  "unknown collection": {
    "status": 404,
    "error": {
      "code": "CollectionNotFound",
      "message": "Collection 'sentinel-99' does not exist."
    }
  },
  "unknown process id": {
    "status": 400,
    "error": {
      "code": "ProcessUnsupported",
      "message": "node `smooth`: unsupported process `apply_kernel` — the supported subset is: load_collection, filter_temporal, reduce_dimension, array_element, add, subtract, multiply, divide, linear_scale_range, ndvi, run_udf, save_result"
    }
  },
  "unknown band": {
    "status": 400,
    "error": {
      "code": "ProcessParameterInvalid",
      "message": "node `load`: unknown band `swir22` — known bands and aliases: [\"b02\", \"b03\", \"b04\", \"b8a\"]"
    }
  },
  "no result node": {
    "status": 400,
    "error": {
      "code": "ProcessGraphInvalid",
      "message": "no result node: exactly one node must set \"result\": true"
    }
  },
  "unsupported output range": {
    "status": 400,
    "error": {
      "code": "ProcessParameterInvalid",
      "message": "node `scale` (linear_scale_range): invalid argument `outputMin`: the Render IR quantizes to 8-bit; the output range must be exactly 0..255, got 0..1"
    }
  },
  "unsupported configuration setting": {
    "status": 400,
    "error": {
      "code": "ServiceConfigUnsupported",
      "message": "Service parameter 'antialias' is not supported."
    }
  }
}
