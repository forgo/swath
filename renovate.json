{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommits",
    ":dependencyDashboard"
  ],
  "description": "One config for Cargo, npm, pip/uv, and GitHub Actions (ENGINEERING.md §5). best-practices includes pinning action digests and config migration.",
  "minimumReleaseAge": "3 days",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 9am on monday"],
    "description": "Refresh transitive pins in Cargo.lock, pnpm-lock and uv.lock weekly, so a yanked or stale transitive arrives as a bot PR through the full gate instead of as a red nightly advisories run (#337)."
  },
  "labels": ["dependencies"],
  "schedule": ["before 9am on monday"],
  "packageRules": [
    {
      "description": "Group all GitHub Actions bumps into one PR",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "description": "Group Rust dependency bumps",
      "matchManagers": ["cargo"],
      "groupName": "rust-dependencies"
    },
    {
      "description": "Group the justfile dev-tool pins",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["justfile"],
      "groupName": "dev-tools"
    },
    {
      "description": "cargo-dist is pinned in dist-workspace.toml AND in the vendored release.yml installer URLs — one grouped PR keeps them in lockstep",
      "matchDepNames": ["cargo-dist"],
      "groupName": "cargo-dist"
    },
    {
      "description": "Security advisories bypass the weekly schedule and cooldown",
      "matchCategories": ["security"],
      "schedule": ["at any time"],
      "minimumReleaseAge": null
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^justfile$/"],
      "matchStrings": ["nextest_version := \"(?<currentValue>[0-9.]+)\""],
      "depNameTemplate": "cargo-nextest",
      "datasourceTemplate": "crate"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^justfile$/"],
      "matchStrings": ["llvm_cov_version := \"(?<currentValue>[0-9.]+)\""],
      "depNameTemplate": "cargo-llvm-cov",
      "datasourceTemplate": "crate"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^justfile$/"],
      "matchStrings": ["deny_version := \"(?<currentValue>[0-9.]+)\""],
      "depNameTemplate": "cargo-deny",
      "datasourceTemplate": "crate"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^justfile$/"],
      "matchStrings": ["zizmor_version := \"(?<currentValue>[0-9.]+)\""],
      "depNameTemplate": "zizmor",
      "datasourceTemplate": "crate"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^justfile$/"],
      "matchStrings": ["prek_version := \"(?<currentValue>[0-9.]+)\""],
      "depNameTemplate": "prek",
      "datasourceTemplate": "crate"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^justfile$/"],
      "matchStrings": ["release_plz_version := \"(?<currentValue>[0-9.]+)\""],
      "depNameTemplate": "release-plz",
      "datasourceTemplate": "crate"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^justfile$/"],
      "matchStrings": ["git_cliff_version := \"(?<currentValue>[0-9.]+)\""],
      "depNameTemplate": "git-cliff",
      "datasourceTemplate": "crate"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^justfile$/"],
      "matchStrings": ["cargo_edit_version := \"(?<currentValue>[0-9.]+)\""],
      "depNameTemplate": "cargo-edit",
      "datasourceTemplate": "crate"
    },
    {
      "customType": "regex",
      "description": "cargo-dist pin in dist-workspace.toml",
      "managerFilePatterns": ["/^dist-workspace\\.toml$/"],
      "matchStrings": ["cargo-dist-version = \"(?<currentValue>[0-9.]+)\""],
      "depNameTemplate": "cargo-dist",
      "packageNameTemplate": "axodotdev/cargo-dist",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "cargo-dist installer URLs in the vendored release workflow",
      "managerFilePatterns": ["/^\\.github/workflows/release\\.yml$/"],
      "matchStrings": ["cargo-dist/releases/download/v(?<currentValue>[0-9.]+)/cargo-dist-installer\\.sh"],
      "depNameTemplate": "cargo-dist",
      "packageNameTemplate": "axodotdev/cargo-dist",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Pinned stable toolchain in rust-toolchain.toml",
      "managerFilePatterns": ["/^rust-toolchain\\.toml$/"],
      "matchStrings": ["channel = \"(?<currentValue>\\d+\\.\\d+(\\.\\d+)?)\""],
      "depNameTemplate": "rust",
      "packageNameTemplate": "rust-lang/rust",
      "datasourceTemplate": "github-releases"
    }
  ]
}
